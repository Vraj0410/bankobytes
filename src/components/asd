import React, { useState } from 'react';
import { Link } from 'react-router-dom';
import ReCAPTCHA from 'react-google-recaptcha';  // Import reCAPTCHA
import './Home.css';

// Your reCAPTCHA site key
const RECAPTCHA_SITE_KEY = '6Lek7EgqAAAAAHlKHTj8DK8fw8Knj7omeX0giaqi'; // Replace with your actual reCAPTCHA site key

const Home = () => {
    const [captchaToken, setCaptchaToken] = useState(null); // To store the reCAPTCHA token
    const [captchaError, setCaptchaError] = useState(false); // To track CAPTCHA validation error
    const [isSubmitting, setIsSubmitting] = useState(false); // To manage submit state

    const handleCaptchaChange = (value) => {
        setCaptchaToken(value); // Store CAPTCHA token
        setCaptchaError(false); // Reset error on successful CAPTCHA
    };

    const handleSubmit = async (e) => {
        e.preventDefault();

        if (!captchaToken) {
            setCaptchaError(true); // Show error if CAPTCHA is not completed
            return;
        }

        setIsSubmitting(true);
        setCaptchaError(false);

        // Simulating a CAPTCHA verification process
        try {
            // Example validation: Check if the token exists (In a real-world case, this would be done on the server-side)
            if (captchaToken) {
                // Here, you'd send the token to your server for validation
                console.log("CAPTCHA verified! Proceeding with form submission...")
                // Perform additional logic like submitting form data
            } else {
                alert('CAPTCHA verification failed. Please try again.');
            }
        } catch (error) {
            console.error('Error verifying CAPTCHA:', error);
            alert('Error verifying CAPTCHA. Please try again.');
        } finally {
            setIsSubmitting(false);
        }
    };

    return (
        <div className="container-Home">
            <div className="background-Home"></div>
            <div className="form-container-Home">
                <h1 className="title-Home">Login here</h1>
                <form className="form-Home" onSubmit={handleSubmit}>
                    <div className="form-group-Home">
                        <label htmlFor="username" className="label-Home">Username:</label>
                        <input type="text" id="username" className="input-Home" placeholder="Enter your username" required />
                    </div>
                    <div className="form-group-Home">
                        <label htmlFor="password" className="label-Home">Password:</label>
                        <input type="password" id="password" className="input-Home" placeholder="Enter your password" required />
                    </div>

                    {/* Google reCAPTCHA */}
                    <div className="form-group-Home">
                        <ReCAPTCHA
                            sitekey={RECAPTCHA_SITE_KEY}
                            onChange={handleCaptchaChange}
                        />
                        {captchaError && <p style={{ color: 'red' }}>Please complete the CAPTCHA</p>}
                    </div>

                    <button type="submit" className="button-Home" disabled={isSubmitting}>
                        {isSubmitting ? 'Submitting...' : 'Login'}
                    </button>
                    <hr className="divider-Home" />
                    <div className="signup-container-Home">
                        <span className="signup-text-Home">Don't have an account?</span>
                        <Link to="/signup" className="signup-link-Home">Signup</Link>
                    </div>
                </form>
            </div>
        </div>
    );
};

export default Home;
